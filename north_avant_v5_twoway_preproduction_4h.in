# ============================================================
# NORTH AVANT V5: 4-HOUR TWO-WAY PREPRODUCTION / SCALING DECK
#
# Physical timeline exercised by this gate
# ----------------------------------------
#   0.0 to 0.5 h : no injection
#   0.5 to 3.0 h : 1.0e-3 m^3/s
#   3.0 to 4.0 h : 1.9e-3 m^3/s
#
# This deliberately passes both rate discontinuities at 0.5 and 3 h.
#
# Validated numerical infrastructure
# ----------------------------------
# Flow grid       : bartlesville_hec_lime_v5_interfaces_median.uge
# Mechanics grid  : bartlesville_hec_lime_v5_interfaces.ugi
# Mapping         : bartlesville_hec_lime_v5_interfaces_median.mapping
# Flow materials  : bartlesville_hec_lime_v5_interfaces_material_ids.h5
# Flow boundaries : boundary_ex_v5/*.ex
#
# This deck preserves the material properties and mechanical boundary
# conditions used in the successful V5 smoke, two-way, and restart tests.
#
# INJECTION-HISTORY INTERPRETATION
# --------------------------------
# The original 96-hour deck omitted INTERPOLATION, for which PFLOTRAN uses
# STEP interpolation by default. This deck writes INTERPOLATION STEP
# explicitly so the old physical schedule is preserved:
#
#   0.0 to 0.5 h   : 0.0 m^3/s
#   0.5 to 3.0 h   : 1.0e-3 m^3/s
#   3.0 to 19.0 h  : 1.9e-3 m^3/s
#   The 4-hour test ends after one hour at the 1.9e-3 m^3/s stage.
#
# Change STEP to LINEAR only if the four tabulated values are known to be
# continuous rate-history waypoints rather than operating stages.
# ============================================================

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  # Writes the fully parsed/internalized input to <prefix>.rec.
  INPUT_RECORD_FILE

  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      # Single-water-phase, isothermal flow. The hydrostatic initial state is
      # fully saturated; retaining RICHARDS preserves the validated workflow.
      MODE RICHARDS
    /
    SUBSURFACE_GEOMECHANICS geomech
      OPTIONS
        FLOW_COUPLING TWO_WAY_COUPLED
      /
    /
  /

  CHECKPOINT
    TIMES hour 5.d-1 3.d0 4.d0
    FORMAT HDF5
    TIME_UNITS hour
  /
END

# ============================================================
# SUBSURFACE FLOW
# ============================================================
SUBSURFACE

GRID
  TYPE UNSTRUCTURED_EXPLICIT bartlesville_hec_lime_v5_interfaces_median.uge
END

NUMERICAL_METHODS FLOW
  TIMESTEPPER
    INITIAL_TIMESTEP_SIZE 1.d-6 day
    # Conservative early-time resolution, controlled growth, and a
    # deliberately refined window around the 19 h shut-in transition.
    MAXIMUM_TIMESTEP_SIZE 5.d-3 hour at 0.d0  hour
    MAXIMUM_TIMESTEP_SIZE 2.d-2 hour at 1.d-1 hour
    MAXIMUM_TIMESTEP_SIZE 5.d-2 hour at 5.d-1 hour
    MAXIMUM_TIMESTEP_SIZE 1.d-1 hour at 3.d0  hour
    PRESSURE_CHANGE_GOVERNOR 1.d5
    SATURATION_CHANGE_GOVERNOR 1.d-1
    TIMESTEP_REDUCTION_FACTOR 5.d-1
    MAXIMUM_CONSECUTIVE_TS_CUTS 20
    MAXIMUM_NUMBER_OF_TIMESTEPS 500000
  /
  NEWTON_SOLVER
    MAXIMUM_NUMBER_OF_ITERATIONS 50
  /
  LINEAR_SOLVER
    SOLVER BCGS
    PRECONDITIONER ASM
    MAXIMUM_NUMBER_OF_ITERATIONS 200
    RTOL 1.d-8
  /
END

TIME
  FINAL_TIME 4.d0 hour
END

REFERENCE_PRESSURE 5.3d6

# -----------------------------------------------------------------------------
# Flow material properties
# -----------------------------------------------------------------------------
MATERIAL_PROPERTY overburden
  ID 1
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 9.869233d-18
    PERM_Y 9.869233d-18
    PERM_Z 9.869233d-19
  /
END

MATERIAL_PROPERTY bartlesville_sand
  ID 2
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 4.9346165d-15
    PERM_Y 4.9346165d-15
    PERM_Z 4.9346165d-17
  /
END

MATERIAL_PROPERTY basal_layer
  ID 3
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 9.869233d-18
    PERM_Y 9.869233d-18
    PERM_Z 9.869233d-19
  /
END

MATERIAL_PROPERTY underburden
  ID 4
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 9.869233d-18
    PERM_Y 9.869233d-18
    PERM_Z 9.869233d-19
  /
END

MATERIAL_PROPERTY hec
  ID 5
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 4.9346165d-13
    PERM_Y 4.9346165d-13
    PERM_Z 9.869233d-17
  /
END

MATERIAL_PROPERTY injection_borehole
  ID 6
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 4.9346165d-13
    PERM_Y 4.9346165d-13
    PERM_Z 9.869233d-17
  /
END

MATERIAL_PROPERTY AVN2
  ID 7
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 9.869233d-18
    PERM_Y 9.869233d-18
    PERM_Z 9.869233d-19
  /
END

MATERIAL_PROPERTY AVN87
  ID 8
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 9.869233d-18
    PERM_Y 9.869233d-18
    PERM_Z 9.869233d-19
  /
END

MATERIAL_PROPERTY AVN31
  ID 9
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 4.9346165d-15
    PERM_Y 4.9346165d-15
    PERM_Z 4.9346165d-17
  /
END

MATERIAL_PROPERTY shallow_limestone
  ID 10
  POROSITY 0.1
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_X 9.869233d-18
    PERM_Y 9.869233d-18
    PERM_Z 9.869233d-19
  /
END

CHARACTERISTIC_CURVES default
  SATURATION_FUNCTION VAN_GENUCHTEN
    ALPHA 1.d-4
    M 0.6d0
    LIQUID_RESIDUAL_SATURATION 0.115d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.6d0
    LIQUID_RESIDUAL_SATURATION 0.115d0
    SMOOTH
  /
END

OUTPUT
  ACKNOWLEDGE_VTK_FLAW
  SCREEN PERIODIC 20
  TIME_UNITS hour
  SNAPSHOT_FILE
    TIMES hour 1.d-2 5.d-2 1.d-1 2.5d-1 5.d-1 1.d0 2.d0 3.d0 3.1d0 3.5d0 4.d0
    FORMAT HDF5
    VARIABLES
      LIQUID_PRESSURE
      MATERIAL_ID
      POROSITY
      PERMEABILITY_X
      PERMEABILITY_Y
      PERMEABILITY_Z
    /
  /
  # Compact global water-balance record for production QA.
  CONSERVATION_FILE
    PERIODIC TIME 1.d-1 hour
  /
END

# -----------------------------------------------------------------------------
# Flow regions and conditions
# -----------------------------------------------------------------------------
REGION All
  COORDINATES
    -1.d10 -1.d10 -1.d10
     1.d10  1.d10  1.d10
  /
END

REGION top
  FILE boundary_ex_v5/top.ex
END
REGION bottom
  FILE boundary_ex_v5/bottom.ex
END
REGION north
  FILE boundary_ex_v5/north.ex
END
REGION south
  FILE boundary_ex_v5/south.ex
END
REGION east
  FILE boundary_ex_v5/east.ex
END
REGION west
  FILE boundary_ex_v5/west.ex
END

REGION injection_borehole
  FILE injection_borehole.vset
END

FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
  /
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 101325.d0
  GRADIENT
    LIQUID_PRESSURE 0.d0 0.d0 -9.81d3
  /
END

FLOW_CONDITION far_field_pressure
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
  /
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 101325.d0
  GRADIENT
    LIQUID_PRESSURE 0.d0 0.d0 -9.81d3
  /
END

FLOW_CONDITION noflow
  TYPE
    LIQUID_FLUX NEUMANN
  /
  LIQUID_FLUX 0.d0
END

# Field injection/recovery schedule.
# STEP is explicit and preserves the behavior of the old 96-hour input deck.
# SYNC_TIMESTEP_WITH_UPDATE forces a timestep boundary at 0.5, 3, and 19 h.
FLOW_CONDITION injection
  TYPE
    RATE SCALED_VOLUMETRIC_RATE VOLUME
  /
  SYNC_TIMESTEP_WITH_UPDATE
  RATE LIST
    TIME_UNITS hour
    DATA_UNITS m^3/s
    INTERPOLATION STEP
    0.d0     0.d0
    0.5d0   1.d-3
    3.d0    1.9d-3
    19.d0   0.d0
  /
END

INITIAL_CONDITION
  FLOW_CONDITION initial
  REGION All
END

SOURCE_SINK inj
  FLOW_CONDITION injection
  REGION injection_borehole
END

BOUNDARY_CONDITION west_bc
  FLOW_CONDITION far_field_pressure
  REGION west
END
BOUNDARY_CONDITION east_bc
  FLOW_CONDITION far_field_pressure
  REGION east
END
BOUNDARY_CONDITION north_bc
  FLOW_CONDITION far_field_pressure
  REGION north
END
BOUNDARY_CONDITION south_bc
  FLOW_CONDITION far_field_pressure
  REGION south
END
BOUNDARY_CONDITION top_bc
  FLOW_CONDITION noflow
  REGION top
END
BOUNDARY_CONDITION bottom_bc
  FLOW_CONDITION noflow
  REGION bottom
END

STRATA
  FILE ./bartlesville_hec_lime_v5_interfaces_material_ids.h5
END

END_SUBSURFACE

# ============================================================
# GEOMECHANICS
# ============================================================
GEOMECHANICS
  GEOMECHANICS_MAPPING_FILE bartlesville_hec_lime_v5_interfaces_median.mapping

  GEOMECHANICS_GRID
    TYPE UNSTRUCTURED bartlesville_hec_lime_v5_interfaces.ugi
    # Zero mechanics gravity makes displacement/strain incremental with
    # respect to the initial hydrostatic state. It intentionally omits
    # lithostatic self-weight from this pressure-induced deformation run.
    GRAVITY 0.d0 0.d0 0.d0
  END

  # Retain the coupling interval used in the validated V5 coupled tests.
  GEOMECHANICS_TIME
    COUPLING_TIMESTEP_SIZE 1.d-2 hour
  END

  # ---------------------------------------------------------------------------
  # Geomechanics regions
  # ---------------------------------------------------------------------------
  GEOMECHANICS_REGION overburden
    FILE overburden.vset
  END
  GEOMECHANICS_REGION shallow_limestone
    FILE shallow_limestone.vset
  END
  GEOMECHANICS_REGION bartlesville_sand
    FILE bartlesville_sand.vset
  END
  GEOMECHANICS_REGION basal_layer
    FILE basal_layer.vset
  END
  GEOMECHANICS_REGION underburden
    FILE underburden.vset
  END
  GEOMECHANICS_REGION hec
    FILE hec.vset
  END
  GEOMECHANICS_REGION injection_borehole
    FILE injection_borehole.vset
  END
  GEOMECHANICS_REGION strainmeter_sensors
    FILE strainmeter_sensors.vset
  END
  GEOMECHANICS_REGION AVN2
    FILE AVN2.vset
  END
  GEOMECHANICS_REGION AVN87
    FILE AVN87.vset
  END
  GEOMECHANICS_REGION AVN31
    FILE AVN31.vset
  END
  GEOMECHANICS_REGION west
    FILE west.vset
  END
  GEOMECHANICS_REGION east
    FILE east.vset
  END
  GEOMECHANICS_REGION north
    FILE north.vset
  END
  GEOMECHANICS_REGION south
    FILE south.vset
  END
  GEOMECHANICS_REGION bottom
    FILE bottom.vset
  END
  GEOMECHANICS_REGION top
    FILE top.vset
  END

  # ---------------------------------------------------------------------------
  # Geomechanics material properties
  # ---------------------------------------------------------------------------
  GEOMECHANICS_MATERIAL_PROPERTY overburden
    ID 1
    ROCK_DENSITY 2700.d0
    YOUNGS_MODULUS 2.0d10
    POISSONS_RATIO 0.28
    BIOT_COEFFICIENT 0.7
  END

  GEOMECHANICS_MATERIAL_PROPERTY bartlesville_sand
    ID 2
    ROCK_DENSITY 2500.d0
    YOUNGS_MODULUS 9.0d9
    POISSONS_RATIO 0.25
    BIOT_COEFFICIENT 0.9
  END

  GEOMECHANICS_MATERIAL_PROPERTY basal_layer
    ID 3
    ROCK_DENSITY 2500.d0
    YOUNGS_MODULUS 2.5d10
    POISSONS_RATIO 0.28
    BIOT_COEFFICIENT 0.7
  END

  GEOMECHANICS_MATERIAL_PROPERTY underburden
    ID 4
    ROCK_DENSITY 2700.d0
    YOUNGS_MODULUS 2.0d10
    POISSONS_RATIO 0.28
    BIOT_COEFFICIENT 0.7
  END

  GEOMECHANICS_MATERIAL_PROPERTY hec
    ID 5
    ROCK_DENSITY 2300.d0
    YOUNGS_MODULUS 9.0d9
    POISSONS_RATIO 0.25
    BIOT_COEFFICIENT 0.9
  END

  GEOMECHANICS_MATERIAL_PROPERTY injection_borehole
    ID 6
    ROCK_DENSITY 2300.d0
    YOUNGS_MODULUS 9.0d9
    POISSONS_RATIO 0.25
    BIOT_COEFFICIENT 0.9
  END

  GEOMECHANICS_MATERIAL_PROPERTY AVN2
    ID 7
    ROCK_DENSITY 2700.d0
    YOUNGS_MODULUS 42.d9
    POISSONS_RATIO 0.28
    BIOT_COEFFICIENT 0.7
  END

  GEOMECHANICS_MATERIAL_PROPERTY AVN87
    ID 8
    ROCK_DENSITY 2700.d0
    YOUNGS_MODULUS 42.d9
    POISSONS_RATIO 0.28
    BIOT_COEFFICIENT 0.7
  END

  GEOMECHANICS_MATERIAL_PROPERTY AVN31
    ID 9
    ROCK_DENSITY 2500.d0
    YOUNGS_MODULUS 9.0d9
    POISSONS_RATIO 0.25
    BIOT_COEFFICIENT 0.9
  END

  GEOMECHANICS_MATERIAL_PROPERTY shallow_limestone
    ID 10
    ROCK_DENSITY 2700.d0
    YOUNGS_MODULUS 42.d9
    POISSONS_RATIO 0.28
    BIOT_COEFFICIENT 0.7
  END

  # ---------------------------------------------------------------------------
  # Geomechanics strata
  # ---------------------------------------------------------------------------
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION overburden
    GEOMECHANICS_MATERIAL overburden
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION shallow_limestone
    GEOMECHANICS_MATERIAL shallow_limestone
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION bartlesville_sand
    GEOMECHANICS_MATERIAL bartlesville_sand
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION basal_layer
    GEOMECHANICS_MATERIAL basal_layer
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION underburden
    GEOMECHANICS_MATERIAL underburden
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION hec
    GEOMECHANICS_MATERIAL hec
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION injection_borehole
    GEOMECHANICS_MATERIAL injection_borehole
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION AVN2
    GEOMECHANICS_MATERIAL AVN2
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION AVN87
    GEOMECHANICS_MATERIAL AVN87
  END
  GEOMECHANICS_STRATA
    GEOMECHANICS_REGION AVN31
    GEOMECHANICS_MATERIAL AVN31
  END

  # ---------------------------------------------------------------------------
  # Mechanical boundary conditions
  # ---------------------------------------------------------------------------
  GEOMECHANICS_CONDITION west_roller
    TYPE
      DISPLACEMENT_X DIRICHLET
    /
    DISPLACEMENT_X 0.d0
  END

  GEOMECHANICS_CONDITION east_roller
    TYPE
      DISPLACEMENT_X DIRICHLET
    /
    DISPLACEMENT_X 0.d0
  END

  GEOMECHANICS_CONDITION north_roller
    TYPE
      DISPLACEMENT_Y DIRICHLET
    /
    DISPLACEMENT_Y 0.d0
  END

  GEOMECHANICS_CONDITION south_roller
    TYPE
      DISPLACEMENT_Y DIRICHLET
    /
    DISPLACEMENT_Y 0.d0
  END

  GEOMECHANICS_CONDITION bottom_fix
    TYPE
      DISPLACEMENT_Z DIRICHLET
    /
    DISPLACEMENT_Z 0.d0
  END

  GEOMECHANICS_BOUNDARY_CONDITION west_bc
    GEOMECHANICS_CONDITION west_roller
    GEOMECHANICS_REGION west
  END
  GEOMECHANICS_BOUNDARY_CONDITION east_bc
    GEOMECHANICS_CONDITION east_roller
    GEOMECHANICS_REGION east
  END
  GEOMECHANICS_BOUNDARY_CONDITION north_bc
    GEOMECHANICS_CONDITION north_roller
    GEOMECHANICS_REGION north
  END
  GEOMECHANICS_BOUNDARY_CONDITION south_bc
    GEOMECHANICS_CONDITION south_roller
    GEOMECHANICS_REGION south
  END
  GEOMECHANICS_BOUNDARY_CONDITION bottom_bc
    GEOMECHANICS_CONDITION bottom_fix
    GEOMECHANICS_REGION bottom
  END

  # Side rollers suppress rigid-body horizontal motion, the bottom is fixed
  # vertically, and the top surface remains traction-free.
  # Explicit times keep flow and geomechanics visualization products aligned.
  GEOMECHANICS_OUTPUT
    TIMES hour 1.d-2 5.d-2 1.d-1 2.5d-1 5.d-1 1.d0 2.d0 3.d0 3.1d0 3.5d0 4.d0
    FORMAT HDF5
  END

END_GEOMECHANICS
